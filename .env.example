NODE_ENV=development
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# Frontend
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SOCKET_URL=
STOCK_APPS_SCRIPT_URL=
STOCK_ACCESS_CODE=
CRON_SECRET=
STOCK_AUTO_REFRESH_DEFAULT_MINUTES=1
STOCK_AUTO_REFRESH_CONFIG_POLL_MS=60000

# News RSS -> Microsoft Teams (worker is disabled until the webhook is configured)
NEWS_TEAMS_WEBHOOK_URL=
# Comma-separated RSS feed URLs. Defaults: Vietnam tech/AI/security, Vietnam banking/Java,
# then global cybersecurity/AI/banking/Java.
NEWS_RSS_URLS=
NEWS_POLL_INTERVAL_MINUTES=5

# Video Short AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_ENDPOINT=https://api.openai.com/v1/responses
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_ENDPOINT=
PROMPT_AI_PROVIDER=openai
PROMPT_AI_FALLBACK=true

# Vẽ vui: off (default), openai, or custom. Gameplay works without AI.
DRAWING_AI_PROVIDER=off
# OpenAI uses OPENAI_API_KEY and OPENAI_MODEL above; optional model override:
DRAWING_AI_MODEL=
# Custom service:
# POST {answer, guess, category, aliases}; response {percent: 0..100, explanation: string}.
DRAWING_AI_URL=
DRAWING_AI_KEY=

SORA2_API_ENDPOINT=
SORA2_STATUS_ENDPOINT=
SORA2_CREATE_PAYLOAD_TEMPLATE=
SORA2_API_KEY=

SEEDANCE_API_ENDPOINT=
SEEDANCE_STATUS_ENDPOINT=
SEEDANCE_CREATE_PAYLOAD_TEMPLATE=
SEEDANCE_API_KEY=

KLING_API_ENDPOINT=
KLING_STATUS_ENDPOINT=
KLING_CREATE_PAYLOAD_TEMPLATE=
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

VEO3_API_ENDPOINT=
VEO3_STATUS_ENDPOINT=
VEO3_CREATE_PAYLOAD_TEMPLATE=
VEO3_API_KEY=

VIDEO_POLL_MAX_ATTEMPTS=20
VIDEO_POLL_INTERVAL_MS=3000

CHITIEU_APPS_SCRIPT_URL=
CHITIEU_ACCESS_CODE=

# BTC paper-trading worker (off unless explicitly enabled)
BTC_BOT_ENABLED=false
BTC_FIREBASE_PROJECT_ID=btc-monitor-ee8e5
BTC_FIREBASE_SERVICE_ACCOUNT=
BTC_ALLOWED_ORIGIN=https://vlhquang.github.io
BTC_ALLOWED_UIDS=
