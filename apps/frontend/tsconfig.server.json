{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "isolatedModules": false
  },
  "include": ["server.ts", "src/**/*.ts"],
  "exclude": ["src/app/**/*", "node_modules", "dist", ".next"]
}
