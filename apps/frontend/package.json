{
  "name": "@karaoke/frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node -e \"(function(){if(process.platform!=='win32'){require('child_process').execSync('npm install @esbuild/'+process.platform+'-x64 --no-save --no-package-lock',{stdio:'inherit'})}})()\" && next build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@karaoke/shared": "1.0.0",
    "@mediapipe/tasks-vision": "^0.10.17",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "esbuild": "^0.24.2",
    "express": "^4.21.2",
    "google-auth-library": "^10.6.1",
    "google-spreadsheet": "^5.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.12.0",
    "next": "^15.5.15",
    "phaser": "^3.90.0",
    "qrcode.react": "^4.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-leaflet": "^5.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.184.0",
    "tsx": "^4.7.0",
    "uuid": "^14.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@next/eslint-plugin-next": "^16.2.10",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.3"
  }
}
